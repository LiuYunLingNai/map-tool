<!-- Same WPF grayscale tokens as the player. Primary: four key bindings;
     secondary: instructions; tertiary: feedback. Save is the single primary action.
     Spacing 4/8/12/16/24, type 12/14/24, radius 8. -->
<Window x:Class="BiliRemote.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义快捷键" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#18181B"
        Background="White">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="#D4D4D8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D4D4D8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="8" Padding="{TemplateBinding Padding}"
                    BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="24">
    <TextBlock Text="自定义快捷键" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="点击输入框，再按下想使用的单键或组合键。" Foreground="#52525B" Margin="0,8,0,0" />
    <TextBlock Text="字母、数字、空格、方向键和功能键均可单独设置，也支持 Ctrl / Alt / Shift / Win 组合。系统保留或已占用的按键以 Windows 注册结果为准。"
               Foreground="#52525B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,24" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
      <TextBlock Text="播放 / 暂停" VerticalAlignment="Center" Margin="0,0,16,12" />
      <TextBox x:Name="ToggleKeyBox" Grid.Column="1" Tag="toggle" Margin="0,0,0,12" PreviewKeyDown="Hotkey_PreviewKeyDown" AutomationProperties.Name="播放暂停快捷键" />
      <TextBlock Grid.Row="1" Text="后退" VerticalAlignment="Center" Margin="0,0,16,12" />
      <TextBox x:Name="BackwardKeyBox" Grid.Row="1" Grid.Column="1" Tag="backward" Margin="0,0,0,12" PreviewKeyDown="Hotkey_PreviewKeyDown" AutomationProperties.Name="后退快捷键" />
      <TextBlock Grid.Row="2" Text="前进" VerticalAlignment="Center" Margin="0,0,16,12" />
      <TextBox x:Name="ForwardKeyBox" Grid.Row="2" Grid.Column="1" Tag="forward" Margin="0,0,0,12" PreviewKeyDown="Hotkey_PreviewKeyDown" AutomationProperties.Name="前进快捷键" />
      <TextBlock Grid.Row="3" Text="停止并回到开头" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBox x:Name="StopKeyBox" Grid.Row="3" Grid.Column="1" Tag="stop" PreviewKeyDown="Hotkey_PreviewKeyDown" AutomationProperties.Name="停止快捷键" />
    </Grid>
    <TextBlock x:Name="FeedbackText" Text="设置期间全局快捷键暂时停用，关闭此窗口后恢复。"
               Foreground="#52525B" TextWrapping="Wrap" Margin="0,16,0,24" MinHeight="36" />
    <Grid>
      <Button Content="恢复默认" HorizontalAlignment="Left" Click="Reset_Click" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Margin="0,0,8,0" IsCancel="True" />
        <Button Content="保存" Background="#18181B" BorderBrush="#18181B" Foreground="White" FontWeight="SemiBold" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
